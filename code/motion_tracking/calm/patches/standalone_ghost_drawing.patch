+def rot_x(angle):
+    c, s = torch.cos(angle), torch.sin(angle)
+    z, o = torch.zeros_like(angle), torch.ones_like(angle)
+    return torch.stack((o, z, z, z, c, -s, z, s, c), dim=-1).reshape(-1, 3, 3)
