+    def adaptive_kl_update(params, normalizer_params, data, key_loss, optimizer_state):
+        """rsl_rl PPO schedule='adaptive': the minibatch KL(old || current) measured before
+        the step rescales the learning rate by 1.5 toward desired_kl, bounded to [1e-5, 1e-2]."""
+        (loss, metrics), grads = loss_and_pgrad_fn(params, normalizer_params, data, key_loss)
