+        inject = optimizer_state[-1] if max_grad_norm is not None else optimizer_state
+        lr = inject.hyperparams["learning_rate"]
+        lr = jnp.where(kl > desired_kl * 2.0, jnp.maximum(1e-5, lr / 1.5),
+                       jnp.where((kl < desired_kl / 2.0) & (kl > 0.0),
+                                 jnp.minimum(1e-2, lr * 1.5), lr))
+        inject = inject._replace(hyperparams={**inject.hyperparams, "learning_rate": lr})
+        optimizer_state = ((*optimizer_state[:-1], inject) if max_grad_norm is not None
+                           else inject)
+        updates, optimizer_state = optimizer.update(grads, optimizer_state)
+        params = optax.apply_updates(params, updates)
+        return (loss, {**metrics, "learning_rate": lr}), params, optimizer_state
 
