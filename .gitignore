.runtime/cache/v13_tasks_jax/

# Local backups and live collection lock/temporary files are not experiment results.
.runtime/local_backups/
runs/**/collection.lock
runs/**/*.tmp

# Background dynamics queue coordination, not an experiment result.
runs/**/queue.lock

# Shared PPO orchestration mutex, not training data.
runs/**/runner.lock

