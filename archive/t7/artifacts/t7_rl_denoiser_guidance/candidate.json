φ checkpoint","sublabel":"Policy + critic","width":146}],"edges":[{"id":"start","from":"noise","to":"denoiser","variant":"default"},{"id":"request-guidance","from":"denoiser","to":"rl_guidance","label":"all 100 steps","variant":"emphasis","role":"branch"},{"id":"apply-residual","from":"rl_guidance","to":"denoiser","label":"residual action","variant":"emphasis","role":"return"},{"id":"decode","from":"denoiser","to":"hardware","label":"x0","variant":"default"},{"id":"adapt","from":"hardware","to":"bank","label":"final only","variant":"dashed"},{"id":"rollout","from":"bank","to":"controller","variant":"default"},{"id":"score","from":"controller","to":"task_return","label":"MJX return","variant":"emphasis"},{"id":"fit-critic","from":"task_return","to":"critic","label":"batch-normalized target","variant":"default"},{"id":"optimize-actor","from":"critic","to":"actor","label":"maximize Q","variant":"emphasis"},{"id":"save","from":"actor","to":"checkpoint","variant":"dashed"}],"cards":[{"dot":"cyan","title":"What stays frozen","items":["TT noise predictor and scheduler remain pretrained","Locomotion policy πθ remains fixed during morphology search"]},{"dot":"amber","title":"What RL replaces","items":["πφ replaces DSG objective gradients at the same guidance hook","The bank is only a final evaluator adapter, not a denoising step"]}]}
